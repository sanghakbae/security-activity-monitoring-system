# Firebase Web App config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: 'firebase' (default) or 'mock' for local UI testing without a backend
VITE_AUTH_MODE=firebase

# Default allowed Google Workspace domain (overridden by security_setting in Firestore)
VITE_ALLOWED_DOMAIN=muhayu.com
