# Firebase Web App config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: 'firebase' (default) or 'mock' for local UI testing without a backend
VITE_AUTH_MODE=firebase

# Allowed Google Workspace domain. Leave empty for no restriction (any account).
# Overridden by the security_setting record in Firestore when present.
VITE_ALLOWED_DOMAIN=

# Exact-email allowlist (comma-separated). When set, ONLY these accounts may
# sign in — takes priority over the domain rule. Leave empty for no email limit.
VITE_ALLOWED_EMAILS=
